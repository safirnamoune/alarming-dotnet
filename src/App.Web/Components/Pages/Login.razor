@page "/"
@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject UserSession Session
@inject NavigationManager Nav

<div class="auth-shell">
    <div class="auth-card">

        <aside class="auth-aside">
            <div class="auth-aside__logo">
                <img src="img/netstability-white.png" alt="Net Stability" />
            </div>
            <div>
                <div class="auth-aside__title">Alarming</div>
                <div class="auth-aside__text">
                    @T("Supervision temps reel et gestion des incidents du reseau.",
                       "Real-time monitoring and network incident management.")
                </div>
            </div>
            <div>
                <div class="auth-aside__meta">
                    <span>@T("Supervision", "Monitoring")</span>
                    <span>@T("Incidents", "Incidents")</span>
                    <span>@T("Ticketing", "Ticketing")</span>
                </div>
                <div class="auth-aside__corp">
                    <span class="auth-aside__corp-label">@T("Un service", "A service by")</span>
                    <span class="auth-aside__chip">
                        <img src="img/djezzy.png" alt="Djezzy" />
                    </span>
                </div>
            </div>
        </aside>

        <main class="auth-main">

            @if (_step == 1)
            {
                <div class="auth-eyebrow">@T("Acces securise", "Secure access")</div>
                <div class="auth-heading">@T("Connexion", "Sign in")</div>
                <div class="auth-sub">@T("Identifiez-vous pour acceder a la supervision.", "Sign in to access the monitoring console.")</div>

                <MudTextField @bind-Value="_login"
                              Label="@T("Utilisateur", "User")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Disabled="_busy"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.PersonOutline"
                              OnKeyDown="OnKeyDown"
                              Class="mb-4" />

                <MudTextField @bind-Value="_password"
                              Label="@T("Mot de passe", "Password")"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Disabled="_busy"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                              OnKeyDown="OnKeyDown"
                              Class="mb-4" />

                <MudSelect @bind-Value="_lang" T="string"
                           Label="@T("Langue", "Language")"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="_busy"
                           Class="mb-6">
                    <MudSelectItem Value="@("fr")">Francais</MudSelectItem>
                    <MudSelectItem Value="@("en")">English</MudSelectItem>
                </MudSelect>

                <MudButton OnClick="SubmitAsync"
                           Variant="Variant.Filled"
                           FullWidth="true"
                           Disabled="_busy"
                           Class="brand-btn">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@T("Connexion...", "Signing in...")</span>
                    }
                    else
                    {
                        <span>@T("Se connecter", "Sign in")</span>
                    }
                </MudButton>
            }
            else
            {
                <div class="auth-eyebrow">@T("Etape 2 sur 2", "Step 2 of 2")</div>
                <div class="auth-heading">@T("Perimetre", "Scope")</div>
                <div class="auth-sub">@T("Choisissez le perimetre et le groupe de travail.", "Choose your scope and working group.")</div>

                <MudSelect Value="_scope" T="string"
                           ValueChanged="OnScopeChangedAsync"
                           Label="@T("Perimetre", "Scope")"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="mb-4">
                    @foreach (var s in _scopes)
                    {
                        <MudSelectItem Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="_group" T="string"
                           Label="@T("Groupe", "Group")"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="_groups.Count <= 1"
                           Class="mb-6">
                    @foreach (var g in _groups)
                    {
                        <MudSelectItem Value="@g">@g</MudSelectItem>
                    }
                </MudSelect>

                <MudButton OnClick="ConfirmScopeAsync"
                           Variant="Variant.Filled"
                           FullWidth="true"
                           Disabled="_busy"
                           Class="brand-btn">
                    @T("Continuer", "Continue")
                </MudButton>

                <MudButton OnClick="BackToLogin"
                           Variant="Variant.Text"
                           FullWidth="true"
                           Class="mt-2 brand-link">
                    @T("Retour", "Back")
                </MudButton>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4" Style="border-radius:12px;">
                    @_error
                </MudAlert>
            }

            <div class="auth-footer">Alarming &middot; migration .NET 9 &middot; phase 1</div>

        </main>
    </div>
</div>

@code {
    private int _step = 1;
    private string _login = "";
    private string _password = "";
    private string _lang = "fr";
    private string _scope = "";
    private string _group = "";
    private List<string> _scopes = [];
    private List<string> _groups = [];
    private string? _error;
    private bool _busy;
    private bool _showPassword;

    private string T(string fr, string en) => _lang == "fr" ? fr : en;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            Session.Language = _lang;
            var result = await Auth.LoginAsync(_login, _password);

            switch (result.Outcome)
            {
                case LoginOutcome.Success:
                    Nav.NavigateTo("/prince");
                    break;

                case LoginOutcome.NeedsScopeSelection:
                    _scopes = result.Scopes ?? [];
                    _scope  = _scopes.FirstOrDefault() ?? "";
                    await LoadGroupsAsync();
                    _step = 2;
                    break;

                default:
                    _error = result.Message;
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = $"Erreur technique : {ex.GetType().Name} - {ex.Message}";
            Console.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnScopeChangedAsync(string scope)
    {
        _scope = scope;
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        _groups = await Auth.GetDepartmentsAsync(_scope);
        _group  = _groups.FirstOrDefault() ?? "";
    }

    private async Task ConfirmScopeAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Auth.ConfirmScopeAsync(_scope, _group);
            _login = "";
            _password = "";
            Nav.NavigateTo("/prince");
        }
        catch (Exception ex)
        {
            _error = $"Erreur technique : {ex.GetType().Name} - {ex.Message}";
            Console.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void BackToLogin()
    {
        _step = 1;
        _error = null;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy)
            await SubmitAsync();
    }
}

