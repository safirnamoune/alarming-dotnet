{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancer App.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/App.Web/bin/Debug/net9.0/App.Web.dll",
      "cwd": "${workspaceFolder}/src/App.Web",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\\\bNow listening on:\\\\s+(https?://\\\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
