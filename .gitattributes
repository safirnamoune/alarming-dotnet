# Normalisation des fins de ligne : LF dans le depot, conversion locale automatique
* text=auto eol=lf

# Fichiers Windows qui doivent rester en CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Binaires : aucune conversion
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.pdf binary